name: Aura E-Commerce CI/CD Flow

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]

jobs:
  # 1. Backend Java Integration tests
  backend-test:
    name: Backend Java Temurin 21 Build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up JDK 21
        uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'
          cache: maven

      - name: Build with Maven
        run: |
          cd backend
          mvn -B clean compile

  # 2. Frontend React compilation tests
  frontend-test:
    name: Frontend React NodeJS 20 Build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up NodeJS 20
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'npm'
          cache-dependency-path: frontend/package.json

      - name: Install dependencies & Compile production bundles
        run: |
          cd frontend
          npm install
          npm run build

  # 3. Docker Integration verification
  docker-build:
    name: Dry-Run Docker Compose Builder
    needs: [backend-test, frontend-test]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Verify Docker Compose Specifications
        run: docker compose config
